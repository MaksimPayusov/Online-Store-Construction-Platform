{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "KrakenD - API Gateway",
  "timeout": "5000ms",
  "output_encoding": "json",
  "port": 8080,
  "endpoints": [
    {
      "endpoint": "/v1/svc1/hello",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["*"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/main_one/protocol/openid-connect/certs",
          "disable_jwk_security": true
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/good-categories/create",
          "method": "POST",
          "host": [
            "http://goodscategory:8080"
          ],
          "encoding": "json"
        }
      ]
    }
  ]
}



