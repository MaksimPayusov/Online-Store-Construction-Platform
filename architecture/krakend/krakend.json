{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "timeout": "5000ms",
  "name": "KrakenD - API Gateway",
  "output_encoding": "no-op",
  "port": 8080,
  "input_headers": [
    "Content-Type",
    "Host",
    "X-Forwarded-Proto",
    "X-Forwarded-Host",
    "X-Forwarded-For",
    "Origin",
    "Cookie",
    "Authorization"
  ],
  "endpoints": [
    {
      "endpoint": "/register",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/auth/register",
          "method": "POST",
          "host": [
            "http://userservice:8080"
          ],
          "encoding": "no-op"       
        }
      ]
    },
    {
      "endpoint": "/basket/add",
      "method": "POST",
      "backend": [
        {
        "url_pattern": "/api/v1/me/basket-items/create",
        "method": "POST",
        "host": [
          "http://basket:8080"
        ],
        "encoding": "json"
        }
      ]
    },
    {
    "endpoint": "/keycloak-protected",
    "extra_config": {
        "auth/validator": {
            "alg": "RS256",
            "jwk_url": "http://keycloak:8080/realms/main_one/protocol/openid-connect/certs",
            "disable_jwk_security": true
        }
    },
    "backend": [
        {
          "host":["http://keycloak:8080"],
          "url_pattern": "/__health"
        }
    ]
  }
  ]
}



